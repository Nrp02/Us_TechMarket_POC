# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Finnhub free tier — price, company news, earnings calendar
FINNHUB_API_KEY=

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security — never expose as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used by `npm run migrate` and `npm run setup-cron`.
# Local tooling only — not needed by the deployed app.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Google AI Studio. Gemini 2.5 Flash is no longer available to new keys;
# see CLAUDE.md for why the model is pinned.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Free news blurbs via OpenRouter (pinned Dots). No paid fallback.
OPENROUTER_API_KEY=

# Groq Story narratives and optional FRED macro readings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
STORY_ANALYSIS_MODEL=openai/gpt-oss-120b
STORY_REVIEW_MODEL=qwen/qwen3.8-27b
FRED_API_KEY=

# Shared secret guarding the ingestion endpoints. Generate with:
#   openssl rand -hex 32
# Must match the value stored in Supabase Vault by `npm run setup-cron`.
CRON_SECRET=

# Deployment origin the scheduled jobs call back into.
APP_BASE_URL=https://<your-app>.vercel.app
