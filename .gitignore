# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the required keys and holds no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP config carries an API token
.mcp.json

# Claude Code tooling. The skills are vendored copies of upstream packages
# (~3.4MB across ~150 files) rather than anything this project authored, and
# the rest is per-machine session state. DESIGN.md and PRODUCT.md are the
# artifacts of this work that belong in the repo, and both are tracked.
.claude/skills/
.claude/settings.local.json
.claude/RESUME.md
.claude/scheduled_tasks.lock

# Generated from DESIGN.md by `/impeccable document` — a build artifact of the
# design pipeline, regenerable and not a source of truth. Note DESIGN.md cites
# .impeccable/design.json as its machine-readable companion; that file is local.
.impeccable/

# Local evidence/rollback captures; authored backfill and review stay tracked.
.scratch/narrative-audit/db-snapshot.json
.scratch/narrative-audit/historical-inputs.json
.scratch/narrative-audit/*-reading.txt
.scratch/narrative-audit/*.before.json
.scratch/narrative-audit/*.after.json
.scratch/narrative-audit/pipeline-sample.json

# Local reasoning experiments and retained provider inputs
.scratch/narrative-audit/reasoning-inputs*.json
.scratch/narrative-audit/recovered-*.json
.scratch/narrative-audit/*.inputs.json
.scratch/narrative-audit/sample-*.json
.scratch/narrative-audit/sample-*.prompt.txt
.scratch/narrative-audit/accepted-*.json
.scratch/narrative-audit/*.log

.scratch/narrative-audit/rejected-*.json
.scratch/narrative-audit/*.rejected.json
.scratch/narrative-audit/reasoned-draft.json
